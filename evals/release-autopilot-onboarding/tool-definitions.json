[
  {
    "name": "get-member-self",
    "description": "Return the member ID, profile, role, and team memberships for the currently authenticated user.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "get-release-autopilot-settings",
    "description": "Get account-wide Release Autopilot settings: whether auto-flagging and auto-releasing are on, and whether auto-flagging pull requests need approval. These are the master gate. Do not use autoCleanup.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "update-release-autopilot-settings",
    "description": "Update account-wide Release Autopilot settings (auto-flagging and auto-releasing). Send only what changed. Requires permission to update account Release Autopilot settings. Do not send autoCleanup.",
    "input_schema": {
      "type": "object",
      "properties": {
        "autoFlagging": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "approvalRequired": {
              "type": "boolean"
            }
          }
        },
        "autoReleasing": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "approvalRequired": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  {
    "name": "list-release-autopilot-github-repos",
    "description": "List GitHub repositories on this account's LaunchDarkly GitHub App install, with name (owner/name) and numeric githubRepoId. When githubConnectUrl is present, give that link to the user and retry after they finish.",
    "input_schema": {
      "type": "object",
      "properties": {
        "projectKey": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "list-release-autopilot-repo-settings",
    "description": "List Release Autopilot settings for GitHub repositories already mapped to a LaunchDarkly project. Each automation is the effective value. githubRepoId is numeric; repo names are not included.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "get-release-autopilot-repo-settings",
    "description": "Get Release Autopilot settings for one GitHub repository. Pass repo as owner/name, or githubRepoId. 404 means the repo is not mapped yet.",
    "input_schema": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "githubRepoId": {
          "type": "number"
        },
        "projectKey": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "update-release-autopilot-repo-settings",
    "description": "Map a GitHub repository to a LaunchDarkly project and optionally override auto-flagging or auto-releasing. Pass repo as owner/name. projectKey is required on the first map. An omitted automation inherits the account setting. Do not send autoCleanup.",
    "input_schema": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "githubRepoId": {
          "type": "number"
        },
        "projectKey": {
          "type": "string"
        },
        "autoFlagging": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "approvalRequired": {
              "type": "boolean"
            }
          }
        },
        "autoReleasing": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "approvalRequired": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  {
    "name": "delete-release-autopilot-repo-settings",
    "description": "Unmap a GitHub repository from Release Autopilot.",
    "input_schema": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "githubRepoId": {
          "type": "number"
        }
      }
    }
  },
  {
    "name": "list-release-plans",
    "description": "List environment-scoped release plans. A release plan is a reusable progressive-release recipe for one environment. It replaces project-level release policies.",
    "input_schema": {
      "type": "object",
      "properties": {
        "projectKey": {
          "type": "string"
        },
        "environmentKey": {
          "type": "string"
        },
        "includeIncomplete": {
          "type": "boolean"
        }
      },
      "required": [
        "projectKey",
        "environmentKey"
      ]
    }
  },
  {
    "name": "create-release-plan",
    "description": "Create an environment-scoped release plan, a reusable progressive-release recipe. Does not start a release. PHASES: 1-10; every phase needs 1-10 clauses AND 1-10 steps. An \"everyone\" phase still needs a clause, e.g. { attribute: \"kind\", op: \"in\", values: [\"user\"], contextKind: \"user\" }. STEPS: allocation is per-100k (5000 = 5%, 100000 = 100%); durationMillis is the hold before the next step. METRICS: keyed object; {} = progressive. advancementMode defaults to manual.",
    "input_schema": {
      "type": "object",
      "properties": {
        "projectKey": {
          "type": "string"
        },
        "environmentKey": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "progressiveRelease": {
          "type": "object",
          "properties": {
            "randomizationUnit": {
              "type": "string"
            },
            "advancementMode": {
              "type": "string",
              "enum": [
                "manual",
                "automatic"
              ]
            },
            "cleanupBehavior": {
              "type": "string",
              "enum": [
                "leave_rules_in_place",
                "remove_rules_and_update_default_rule"
              ]
            },
            "phases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "clauses": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "attribute": {
                          "type": "string"
                        },
                        "op": {
                          "type": "string",
                          "enum": [
                            "in",
                            "endsWith",
                            "startsWith",
                            "matches",
                            "contains",
                            "lessThan",
                            "lessThanOrEqual",
                            "greaterThan",
                            "greaterThanOrEqual",
                            "before",
                            "after",
                            "semVerEqual",
                            "semVerLessThan",
                            "semVerGreaterThan",
                            "segmentMatch"
                          ]
                        },
                        "values": {
                          "type": "array",
                          "items": {}
                        },
                        "contextKind": {
                          "type": "string"
                        },
                        "negate": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "attribute",
                        "op",
                        "values"
                      ]
                    }
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "allocation": {
                          "type": "number"
                        },
                        "durationMillis": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "allocation",
                        "durationMillis"
                      ]
                    }
                  }
                },
                "required": [
                  "clauses",
                  "steps"
                ]
              }
            },
            "metrics": {
              "type": "object"
            }
          },
          "required": [
            "randomizationUnit",
            "phases"
          ]
        }
      },
      "required": [
        "projectKey",
        "environmentKey",
        "key",
        "name",
        "progressiveRelease"
      ]
    }
  }
]
